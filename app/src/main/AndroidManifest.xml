<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.ellison.jetpackdemo">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".MyApplication"
        android:debuggable="true"
        android:allowBackup="true"
        android:icon="@drawable/ic_jetpack"
        android:label="@string/app_name"
        android:usesCleartextTraffic="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.JetpackDemo">

        <activity android:name=".MainActivity"
            android:exported="true"
            android:configChanges="uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".dagger2.DemoActivity"
            android:label="Dagger2"
            android:exported="false">
        </activity>

        <activity android:name=".hilt.DemoActivity"
            android:label="Hilt"
            android:exported="false">
        </activity>
    </application>

</manifest>
